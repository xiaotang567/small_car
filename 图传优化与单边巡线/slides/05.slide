<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 40, flexDirection: 'column', fontFamily: "'Microsoft YaHei', sans-serif" }}>
  <Box style={{ flexDirection: 'row', alignItems: 'center', height: 56, background: '#1E4FA8', borderRadius: 6, paddingLeft: 24, paddingRight: 24 }}>
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF' }}>像素点操作：所有巡线算法的地基</Text>
    <Box style={{ flex: 1 }} />
    <Text style={{ fontSize: 16, color: '#DCE8FA' }}></Text>
  </Box>

  <Box style={{ height: 16 }} />

  <Box style={{ flex: 1, flexDirection: 'column' }}>
    <Box style={{ flexDirection: 'row', gap: 20, flex: 1 }}>
      <Box style={{ width: 620, flexDirection: 'column', background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 8, padding: 20, gap: 4 }}>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#0E3F8C', marginBottom: 8 }}>六个基本操作（越界先夹范围）</Text>
        <Box style={{ flexDirection: 'row', height: 40, alignItems: 'center' }}>
          <Text style={{ fontSize: 19, color: '#1A2230', width: 150 }}>读一个点</Text>
          <Text style={{ fontSize: 17, color: '#3D7BD9', fontFamily: 'Consolas, monospace' }}>v = disp_img[r][c];</Text>
        </Box>
        <Box style={{ flexDirection: 'row', height: 40, alignItems: 'center' }}>
          <Text style={{ fontSize: 19, color: '#1A2230', width: 150 }}>涂白 / 涂黑</Text>
          <Text style={{ fontSize: 17, color: '#3D7BD9', fontFamily: 'Consolas, monospace' }}>disp_img[r][c] = 255U / 0U;</Text>
        </Box>
        <Box style={{ flexDirection: 'row', height: 40, alignItems: 'center' }}>
          <Text style={{ fontSize: 19, color: '#1A2230', width: 150 }}>反色（挖线）</Text>
          <Text style={{ fontSize: 17, color: '#3D7BD9', fontFamily: 'Consolas, monospace' }}>disp_img[r][c] ^= 0xFFU;</Text>
        </Box>
        <Box style={{ flexDirection: 'row', height: 40, alignItems: 'center' }}>
          <Text style={{ fontSize: 19, color: '#1A2230', width: 150 }}>画横线</Text>
          <Text style={{ fontSize: 17, color: '#3D7BD9', fontFamily: 'Consolas, monospace' }}>for (c=c0;c<=c1;c++) disp_img[r][c]=255U;</Text>
        </Box>
        <Box style={{ flexDirection: 'row', height: 40, alignItems: 'center' }}>
          <Text style={{ fontSize: 19, color: '#1A2230', width: 150 }}>画竖线</Text>
          <Text style={{ fontSize: 17, color: '#3D7BD9', fontFamily: 'Consolas, monospace' }}>for (r=r0;r<=r1;r++) disp_img[r][c]=255U;</Text>
        </Box>
        <Box style={{ flexDirection: 'row', height: 40, alignItems: 'center' }}>
          <Text style={{ fontSize: 19, color: '#1A2230', width: 150 }}>画粗一点</Text>
          <Text style={{ fontSize: 17, color: '#3D7BD9', fontFamily: 'Consolas, monospace' }}>disp_img[r][c]=disp_img[r+1][c]=255U;</Text>
        </Box>
      </Box>

      <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
        <Box style={{ background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: 20, flexDirection: 'column', gap: 8 }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#0E3F8C' }}>画"连续线"的关键：逐行插值</Text>
          <Text style={{ fontSize: 18, color: '#4A5568', fontFamily: 'Consolas, monospace', lineHeight: 1.5 }}>for (r=1; r&lt;120; r++)&#10;  b0=b[r-1]; b1=b[r];&#10;  for (i=0;i&lt;=abs(b1-b0);i++)&#10;    disp_img[r][b0+i*step]=255U;</Text>
          <Text style={{ fontSize: 18, color: '#D9534F' }}>只画单点 ⇒ 屏幕上是虚线 ✗</Text>
          <Text style={{ fontSize: 18, color: '#0E3F8C' }}>插值补满 ⇒ 一条连续折线 ✓</Text>
        </Box>
        <Box style={{ background: '#E8EFF8', borderRadius: 8, padding: 16 }}>
          <Text style={{ fontSize: 18, color: '#4A5568' }}>代码里已有三段范例：Otsu 统计（1806）→ 二值化（1839）→ 逐行找交界（1845）</Text>
        </Box>
      </Box>
    </Box>
  </Box>

  <Box style={{ flexDirection: 'row', alignItems: 'center', height: 28 }}>
    <Text style={{ fontSize: 14, color: '#8B97A8' }}>智能车主板 · F407 + 总钻风 MT9V034 · 图传与巡线</Text>
    <Box style={{ flex: 1 }} />
    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1E4FA8' }}>05 / 08</Text>
  </Box>
</Slide>
