<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 40, flexDirection: 'column', fontFamily: "'Microsoft YaHei', sans-serif" }}>
  <Box style={{ flexDirection: 'row', alignItems: 'center', height: 56, background: '#1E4FA8', borderRadius: 6, paddingLeft: 24, paddingRight: 24 }}>
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF' }}>单边巡线：为什么先做单边</Text>
    <Box style={{ flex: 1 }} />
    <Text style={{ fontSize: 16, color: '#DCE8FA' }}></Text>
  </Box>

  <Box style={{ height: 16 }} />

  <Box style={{ flex: 1, flexDirection: 'column' }}>
    <Box style={{ flexDirection: 'row', gap: 20, flex: 1 }}>
    <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 8, padding: 20, flexDirection: 'column', gap: 10 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 6, height: 24, background: '#D9534F', borderRadius: 3 }} />
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#0E3F8C' }}>双边的问题</Text>
      </Box>
      <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.55 }}>要求左右两条边界同时稳定</Text>
      <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.55 }}>遇到十字、断路、反光 ⇒ 一边丢失</Text>
      <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.55 }}>中线会突然跳变 ⇒ 舵机猛打</Text>
      <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.55 }}>调试成本高，先把车跑起来更重要</Text>
    </Box>
    <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 8, padding: 20, flexDirection: 'column', gap: 10 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 6, height: 24, background: '#1E4FA8', borderRadius: 3 }} />
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#0E3F8C' }}>单边怎么做</Text>
      </Box>
      <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.55 }}>每行从画面中间往左找"白→黑"</Text>
      <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.55 }}>b[r] = 该行边界列（0xFF = 没找到）</Text>
      <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.55 }}>插值补点 ⇒ 一条连续线</Text>
      <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.55 }}>中线 = 边界 + 半赛道宽（标定值）</Text>
    </Box>
    <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 8, padding: 20, flexDirection: 'column', gap: 10 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 6, height: 24, background: '#3D7BD9', borderRadius: 3 }} />
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#0E3F8C' }}>稳定化三招</Text>
      </Box>
      <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.55 }}>防抖：要求连续 2~3 像素同向</Text>
      <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.55 }}>限幅：相邻行跳变 >10 就沿用上一行</Text>
      <Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.55 }}>丢行：沿用上一帧该行边界</Text>
    </Box>
    </Box>

    <Box style={{ height: 16 }} />

    <Box style={{ flexDirection: 'row', gap: 16, height: 110 }}>
      <Box style={{ flex: 1, background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: 16 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>验收标准</Text>
        <Text style={{ fontSize: 18, color: '#4A5568', marginTop: 6 }}>摄像头看过去，屏幕上那条线要<b>贴着赛道、连续不断</b></Text>
      </Box>
      <Box style={{ flex: 1, background: '#E8EFF8', border: '1px solid #D6DCE5', borderRadius: 8, padding: 16 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>打角公式</Text>
        <Text style={{ fontSize: 18, color: '#4A5568', marginTop: 6 }}>e = Σ w[r]·(C[r] − 94)，舵机 = 中值 + Kp·e</Text>
      </Box>
    </Box>
  </Box>

  <Box style={{ flexDirection: 'row', alignItems: 'center', height: 28 }}>
    <Text style={{ fontSize: 14, color: '#8B97A8' }}>智能车主板 · F407 + 总钻风 MT9V034 · 图传与巡线</Text>
    <Box style={{ flex: 1 }} />
    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1E4FA8' }}>07 / 08</Text>
  </Box>
</Slide>
